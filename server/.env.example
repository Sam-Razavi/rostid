# Environment variables — copy to .env and fill in your values
# Required fields have no default and must be set before starting the server.

# ── App ───────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# URL of the React client (used for CORS and email links)
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://rostid:rostid_password@localhost:5432/rostid_db

# ── Auth ──────────────────────────────────────────────────────────────────────

# Must be at least 32 characters — use a random generator, never reuse across envs
JWT_ACCESS_SECRET=change-me-to-a-random-32-char-secret-access
JWT_REFRESH_SECRET=change-me-to-a-random-32-char-secret-refresh

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Must be at least 16 characters
COOKIE_SECRET=change-me-cookie-secret

# ── Stripe ────────────────────────────────────────────────────────────────────

# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret from `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Resend) ────────────────────────────────────────────────────────────

# Optional — emails are skipped when not set (dev mode)
# Get an API key at https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@rostid.se

# ── Admin ─────────────────────────────────────────────────────────────────────

# Optional — admin notification emails are sent here when set
ADMIN_EMAIL=admin@rostid.se

# ── Monitoring ────────────────────────────────────────────────────────────────

# Optional — Sentry DSN for error tracking (https://sentry.io)
SENTRY_DSN=

# Optional — secret for cron job endpoints
CRON_SECRET=
