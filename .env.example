# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://rostid:rostid_password@localhost:5432/rostid_db

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Cookie
COOKIE_SECRET=your-cookie-secret-here

# Stripe — get from https://dashboard.stripe.com/apikeys
# Leave empty to disable payment features in development
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — get from https://resend.com/api-keys
# Leave empty to disable email sending in development
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Sentry — get from https://sentry.io
# Optional — leave empty to disable error monitoring
SENTRY_DSN=

# Production database (used by docker-compose.prod.yml)
POSTGRES_USER=rostid
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=rostid_db

# Client API URL (used by docker-compose.prod.yml client build)
VITE_API_URL=https://api.yourdomain.com/api
