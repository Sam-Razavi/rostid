# Server — set these in Railway dashboard
NODE_ENV=production
PORT=4000

# PostgreSQL — Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-64-byte-hex-secret
JWT_REFRESH_SECRET=your-other-64-byte-hex-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your-32-byte-hex-secret

# CORS — set to your Vercel deployment URL
CLIENT_URL=https://your-app.vercel.app

# Stripe — get from https://dashboard.stripe.com/apikeys (use live keys for production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com
